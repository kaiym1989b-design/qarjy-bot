# Бұл файлды .env деп көшіріп, мәндерін толтырыңыз. .env файлын ешқашан GitHub-қа жүктемеңіз!

# @BotFather берген токен
BOT_TOKEN=1234567890:AAAA-сіздің-токеніңіз

# Supabase → Connect → Session pooler (5432 порт) жолы
DATABASE_URL=postgresql://postgres.xxxxxxxx:ҚҰПИЯСӨЗ@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Міндетті емес
BOT_TIMEZONE=Asia/Almaty
WEEKLY_TIP_DAY=sun
WEEKLY_TIP_HOUR=19
