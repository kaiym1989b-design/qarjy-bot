# Бұл файлды .env деп көшіріп, мәндерін толтырыңыз. .env файлын ешқашан GitHub-қа жүктемеңіз!

# @BotFather берген токен
BOT_TOKEN=1234567890:AAAA-сіздің-токеніңіз

# Supabase дерекқор құпиясөзі — жеткілікті, қалған жолды бот өзі құрады
DB_PASSWORD=supabase-құпиясөзі

# Немесе толық жолды бергің келсе (бұл болса, DB_PASSWORD қолданылмайды):
# DATABASE_URL=postgresql://postgres.xxxx:ҚҰПИЯСӨЗ@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Міндетті емес
BOT_TIMEZONE=Asia/Almaty
WEEKLY_TIP_DAY=sun
WEEKLY_TIP_HOUR=19
